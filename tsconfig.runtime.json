{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["api/erp.ts", "api/health.ts", "server/**/*.ts", "src/lib/providers/erp/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
