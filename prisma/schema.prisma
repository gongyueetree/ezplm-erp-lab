generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ErpSimTenant {
  id               String                   @id
  datasetName      String
  seededAt         DateTime
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  materials        ErpSimMaterial[]
  manufacturers    ErpSimManufacturer[]
  warehouses       ErpSimWarehouse[]
  inventory        ErpSimInventory[]
  excess           ErpSimExcess[]
  suppliers        ErpSimSupplier[]
  customers        ErpSimCustomer[]
  exchangeRates    ErpSimExchangeRate[]
  purchaseOrders   ErpSimPurchaseOrder[]
  receipts         ErpSimReceipt[]
  workOrders       ErpSimWorkOrder[]
  salesOrders      ErpSimSalesOrder[]
  scenario         ErpSimScenario?
  requestLogs      ErpSimRequestLog[]
  auditLogs        ErpSimAuditLog[]
  mappingProfiles  ErpSimMappingProfile[]
}

model ErpSimManufacturer {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId       String
  manufacturerCode String
  name             String
  status           String?
  sourceUpdatedAt  DateTime?

  @@unique([tenantId, externalId])
  @@unique([tenantId, manufacturerCode])
  @@unique([tenantId, name])
}

model ErpSimWarehouse {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId      String
  warehouseCode   String
  name            String
  status          String?
  sourceUpdatedAt DateTime?

  @@unique([tenantId, externalId])
  @@unique([tenantId, warehouseCode])
}

model ErpSimMaterial {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId    String
  materialCode  String
  internalPn    String?
  manufacturer  String?
  mpn           String?
  description   String?
  specification String?
  unit          String?
  lifecycle     String?
  status        String?
  sourceUpdatedAt DateTime?

  @@unique([tenantId, externalId])
  @@index([tenantId, materialCode])
}

model ErpSimInventory {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId    String
  materialCode  String
  warehouseCode String?
  warehouseName String?
  customerCode  String?
  onHandQty     Decimal      @db.Decimal(30, 10)
  availableQty  Decimal?     @db.Decimal(30, 10)
  reservedQty   Decimal?     @db.Decimal(30, 10)
  lotNo         String?
  sourceUpdatedAt DateTime?

  @@unique([tenantId, externalId])
  @@index([tenantId, materialCode])
}

model ErpSimExcess {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId        String
  materialCode      String
  customerCode      String?
  warehouseCode     String?
  bookQty           Decimal      @db.Decimal(30, 10)
  availableQty      Decimal      @db.Decimal(30, 10)
  earliestInboundAt DateTime?
  sourceDocumentId  String?
  sourceUpdatedAt   DateTime?

  @@unique([tenantId, externalId])
  @@index([tenantId, materialCode])
}

model ErpSimSupplier {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId    String
  supplierCode  String
  name          String
  status        String?
  currency      String?
  sourceUpdatedAt DateTime?

  @@unique([tenantId, externalId])
  @@index([tenantId, supplierCode])
}

model ErpSimCustomer {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId    String
  customerCode  String
  name          String
  status        String?
  sourceUpdatedAt DateTime?

  @@unique([tenantId, externalId])
  @@index([tenantId, customerCode])
}

model ErpSimExchangeRate {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseCurrency  String
  quoteCurrency String
  rate          Decimal      @db.Decimal(30, 12)
  rateType      String?
  effectiveDate DateTime
  source        String

  @@unique([tenantId, baseCurrency, quoteCurrency, effectiveDate])
}

model ErpSimPurchaseOrder {
  id             String                    @id @default(cuid())
  tenantId       String
  tenant         ErpSimTenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId     String?
  poNumber       String?
  supplierCode   String
  currency       String
  orderDate      DateTime
  requestedDate  DateTime?
  status         String?
  idempotencyKey String?
  lines          ErpSimPurchaseOrderLine[]

  @@unique([tenantId, externalId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, poNumber])
}

model ErpSimPurchaseOrderLine {
  id              String              @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   ErpSimPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNo          Int
  materialCode    String
  qty             Decimal             @db.Decimal(30, 10)
  unitPrice       Decimal             @db.Decimal(30, 10)
  requestedDate   DateTime?
  confirmedQty    Decimal?            @db.Decimal(30, 10)
  /// closed-loop: 累计收货量(receivePurchaseOrder 维护)
  receivedQty     Decimal?            @db.Decimal(30, 10)
  eta             DateTime?
  shipDate        DateTime?

  @@unique([purchaseOrderId, lineNo])
}

// closed-loop: 收货单(PO → 收货 → 库存 → 状态推进 的最小闭环)
model ErpSimReceipt {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         ErpSimTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId     String
  receiptNumber  String
  poExternalId   String
  poNumber       String?
  receivedAt     DateTime
  idempotencyKey String?
  lines          ErpSimReceiptLine[]

  @@unique([tenantId, externalId])
  @@unique([tenantId, idempotencyKey])
}

model ErpSimReceiptLine {
  id            String        @id @default(cuid())
  receiptId     String
  receipt       ErpSimReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineNo        Int
  materialCode  String
  qty           Decimal       @db.Decimal(30, 10)
  lotNo         String?
  warehouseCode String?
}

// LAB-1: 工单（供 ECN 影响分析与缺料/齐料闭环消费）。
// consumedLines 用子表存（与 PO Line 同一纪律：DECIMAL、行级唯一）。
model ErpSimWorkOrder {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           ErpSimTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId       String
  woNumber         String
  customerCode     String?
  productCode      String
  bomRef           String?
  qty              Decimal               @db.Decimal(30, 10)
  /// PLANNED / IN_PROGRESS / COMPLETED / SHIPPED
  status           String
  currentOperation String?
  plannedStart     DateTime?
  plannedEnd       DateTime?
  consumedLines    ErpSimWorkOrderLine[]

  @@unique([tenantId, externalId])
  @@index([tenantId, woNumber])
  @@index([tenantId, status])
}

model ErpSimWorkOrderLine {
  id           String          @id @default(cuid())
  workOrderId  String
  workOrder    ErpSimWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  materialCode String
  consumedQty  Decimal         @db.Decimal(30, 10)

  @@unique([workOrderId, materialCode])
}

// LAB-1: 销售订单（客户需求侧，供缺料闭环与门户消费）。
model ErpSimSalesOrder {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       ErpSimTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId   String
  soNumber     String
  customerCode String
  status       String?
  lines        ErpSimSalesOrderLine[]

  @@unique([tenantId, externalId])
  @@index([tenantId, soNumber])
  @@index([tenantId, customerCode])
}

model ErpSimSalesOrderLine {
  id            String           @id @default(cuid())
  salesOrderId  String
  salesOrder    ErpSimSalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lineNo        Int
  productCode   String
  qty           Decimal          @db.Decimal(30, 10)
  shippedQty    Decimal?         @db.Decimal(30, 10)
  requestedDate DateTime?

  @@unique([salesOrderId, lineNo])
}

model ErpSimScenario {
  id              String       @id @default(cuid())
  tenantId        String       @unique
  tenant          ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String
  enabled         Boolean
  latencyMs       Int
  failureRate     Float
  targetOperation String?
}

model ErpSimRequestLog {
  id              String       @id
  tenantId        String
  tenant          ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp       DateTime
  operation       String
  requestId       String
  /// closed-loop: 主系统传入的关联 id(X-Correlation-Id)
  correlationId   String?
  attempt         Int
  requestPayload  Json?
  responsePayload Json?
  latency         Int
  scenario        String
  result          String
  errorCode       String?
  errorMessage    String?

  @@index([tenantId, timestamp(sort: Desc)])
}

model ErpSimAuditLog {
  id         String       @id
  tenantId   String
  tenant     ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp  DateTime
  actor      String
  action     String
  entityType String
  entityId   String?
  result     String
  details    String?

  @@index([tenantId, timestamp(sort: Desc)])
}

model ErpSimMappingProfile {
  id          String       @id
  tenantId    String
  tenant      ErpSimTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  datasetType String
  mappings    Json
  createdAt   DateTime

  @@index([tenantId, datasetType])
}
